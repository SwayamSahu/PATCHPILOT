# ---------------------------------------------------------------------------
# PatchPilot environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- TrueForge harness -----------------------------------------------------
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_BASE=http://localhost:8790/api/v1

# --- Model provider (agents run on Anthropic) ------------------------------
ANTHROPIC_API_KEY=
PATCHPILOT_ORCHESTRATOR_MODEL=claude-opus-5
PATCHPILOT_SUBAGENT_MODEL=claude-sonnet-5

# --- Sandbox provider (real isolated execution) ----------------------------
DAYTONA_API_KEY=

# --- GitHub (real branches, commits, pull requests) ------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# --- PatchPilot services ---------------------------------------------------
PATCHPILOT_API_PORT=8080
PATCHPILOT_WEB_PORT=3000
SIMULATOR_PORT=8000
MCP_TELEMETRY_PORT=8101
MCP_REPOSITORY_PORT=8102
MCP_DEPLOYMENT_PORT=8103

# Shared secret so MCP servers can reach the PatchPilot approval API.
# Generate with: openssl rand -hex 32
PATCHPILOT_INTERNAL_SECRET=
