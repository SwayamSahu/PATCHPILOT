# ---------------------------------------------------------------------------
# PatchPilot environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- TrueForge harness -----------------------------------------------------
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_API_BASE=http://localhost:8790/api/v1

# --- Model provider --------------------------------------------------------
# PatchPilot runs on a local, free model served by Ollama through its
# OpenAI-compatible API. TrueForge accepts any OpenAI-compatible endpoint, so no
# hosted account or paid key is required to run this project.
#
#   1. install Ollama            https://ollama.com
#   2. ollama pull qwen3:8b
#   3. OLLAMA_CONTEXT_LENGTH=32768 ollama serve
#
# The API key is required by the OpenAI protocol but ignored by Ollama; any
# non-empty string works.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
PATCHPILOT_ORCHESTRATOR_MODEL=qwen3:8b
PATCHPILOT_SUBAGENT_MODEL=qwen3:8b

# Local models have small default context windows. The agent loop carries tool
# schemas plus accumulated results, so an undersized window silently truncates
# and tool calls begin to fail. Serve Ollama with at least 32k.
OLLAMA_CONTEXT_LENGTH=32768

# --- Sandbox provider (real isolated execution) ----------------------------
DAYTONA_API_KEY=

# --- GitHub (real branches, commits, pull requests) ------------------------
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# --- PatchPilot services ---------------------------------------------------
PATCHPILOT_API_PORT=8080
PATCHPILOT_WEB_PORT=3000
SIMULATOR_PORT=8000
MCP_TELEMETRY_PORT=8101
MCP_REPOSITORY_PORT=8102
MCP_DEPLOYMENT_PORT=8103

# Shared secret so MCP servers can reach the PatchPilot approval API.
# Generate with: openssl rand -hex 32
PATCHPILOT_INTERNAL_SECRET=
